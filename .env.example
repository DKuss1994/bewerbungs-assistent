# Vorlage – kopieren nach .env (python -m src.einrichtung macht das automatisch)

# Versand (SMTP)
SMTP_SERVER=smtp.example.org
SMTP_PORT=587
EMAIL_ABSENDER=
EMAIL_PASSWORT=

# Postfach lesen (IMAP)
IMAP_SERVER=imap.example.org
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# KI: ollama (lokal, Standard) oder mistral (braucht MISTRAL_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b-instruct
# LLM_MODEL_TEXT=qwen2.5:7b-instruct
# MISTRAL_API_KEY=

# Telegram-Bot (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# taeglich | woechentlich | aus
POSTFACH_PRUEFEN=taeglich
